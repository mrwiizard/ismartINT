---
import fs from 'node:fs';
import path from 'node:path';
import { ArrowRight } from 'lucide-react';

/**
 * SECTION 01 — HERO
 *
 * Composition: headline sits at the top on clean, undisturbed graphite so it
 * reads instantly. All visual activity is pushed BELOW the type into a band of
 * silver and bronze strips framing the portrait, with bronze chevrons marking
 * the flow of value inward. Nothing animates behind the text.
 *
 * Motion is CSS-only and slow — no canvas, no JS on the critical path.
 */

// Portrait is a drop-in: add the file and it appears, no code change needed.
const PORTRAIT = 'hero-portrait.png';
const hasPortrait = fs.existsSync(path.join(process.cwd(), 'public', PORTRAIT));

// Strip field: silver by default, bronze used sparingly as the accent.
const strips = [
  { left: 4,  w: 2,  h: 62, tone: 'silver', delay: 0,    dur: 15 },
  { left: 11, w: 1,  h: 84, tone: 'silver', delay: -3,   dur: 19 },
  { left: 17, w: 3,  h: 46, tone: 'bronze', delay: -6,   dur: 17 },
  { left: 24, w: 1,  h: 72, tone: 'silver', delay: -1.5, dur: 21 },
  { left: 30, w: 2,  h: 92, tone: 'silver', delay: -8,   dur: 16 },
  { left: 36, w: 1,  h: 54, tone: 'silver', delay: -4,   dur: 23 },

  { left: 63, w: 1,  h: 58, tone: 'silver', delay: -2,   dur: 20 },
  { left: 69, w: 2,  h: 88, tone: 'silver', delay: -7,   dur: 17 },
  { left: 76, w: 1,  h: 68, tone: 'silver', delay: -5,   dur: 22 },
  { left: 82, w: 3,  h: 44, tone: 'bronze', delay: -9,   dur: 18 },
  { left: 89, w: 1,  h: 78, tone: 'silver', delay: -3.5, dur: 15 },
  { left: 95, w: 2,  h: 60, tone: 'silver', delay: -6.5, dur: 24 },
];
---

<section
  data-nav-theme="dark"
  class="hero surface-graphite grain relative isolate flex min-h-[100svh] flex-col overflow-hidden"
>
  {/* ================= BACKGROUND — strips band, below the type ================= */}
  <div class="strip-field pointer-events-none absolute inset-x-0 bottom-0 top-[38%] z-0">
    {strips.map((s) => (
      <span
        class:list={['strip', s.tone === 'bronze' ? 'strip-bronze' : 'strip-silver']}
        style={`left:${s.left}%;width:${s.w}px;height:${s.h}%;animation-delay:${s.delay}s;animation-duration:${s.dur}s`}
      />
    ))}
  </div>

  {/* Emerald ground-light, kept low and wide so it never touches the headline */}
  <div
    class="pointer-events-none absolute -bottom-[30%] left-1/2 z-0 h-[60vh] w-[110vw] -translate-x-1/2 rounded-[50%] bg-emerald-700/22 blur-[150px]"
  >
  </div>

  {/* ================= CONTENT ================= */}
  <div class="relative z-10 mx-auto flex w-full max-w-6xl flex-1 flex-col items-center px-6 pb-12 pt-32 text-center md:px-10 lg:pt-36">
    {/* Eyebrow */}
    <div data-reveal="fade" class="mb-7 flex items-center gap-3 text-silver-400">
      <span class="h-px w-8 bg-gradient-to-r from-transparent to-bronze-500"></span>
      <span class="eyebrow">Digital Financial Infrastructure</span>
      <span class="h-px w-8 bg-gradient-to-l from-transparent to-bronze-500"></span>
    </div>

    {/* Headline — sits on clean graphite, nothing moving behind it */}
    <h1
      data-reveal
      style="--reveal-delay:80ms"
      class="max-w-[16ch] font-display text-[clamp(2.5rem,6.4vw,5.5rem)] font-extrabold leading-[0.96] tracking-[-0.035em]"
    >
      <span class="text-metal">Powering Africa's next generation of</span>
      <span class="text-bronze-object"> digital payments.</span>
    </h1>

    {/* CTAs — Pulled up directly below the heading */}
    <div data-reveal style="--reveal-delay:180ms" class="mt-8 flex flex-wrap items-center justify-center gap-4">
      <a
        href="#ecosystem"
        class="btn-metal"
      >
        Explore our ecosystem
        <ArrowRight className="h-4 w-4 transition-transform duration-500 group-hover:translate-x-1" />
      </a>

      <a
        href="/contact"
        class="inline-flex items-center rounded-full border border-white/15 bg-white/[0.03] px-8 py-4 font-display text-sm font-semibold text-silver-200 backdrop-blur-sm transition-all duration-500 hover:border-bronze-500/50 hover:bg-white/[0.06] hover:text-white"
      >
        Talk to iSmart
      </a>
    </div>

    {/* ================= PORTRAIT STAGE — ENLARGED & BOLD ================= */}
    <div data-reveal="fade" style="--reveal-delay:260ms" class="relative mt-12 w-full max-w-[960px] h-[550px] md:h-[650px] flex items-end justify-center">
      
      {/* Intersecting Silver & Bronze Metallic Chevrons (Flyer style) */}
      <svg class="pointer-events-none absolute inset-0 w-full h-full z-0" viewBox="0 0 500 500" fill="none" preserveAspectRatio="none" aria-hidden="true">
        <defs>
          <linearGradient id="silverChevronGrad" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0%" stopColor="#FFFFFF" stopOpacity="0.18" />
            <stop offset="50%" stopColor="#8E9093" stopOpacity="0.08" />
            <stop offset="100%" stopColor="#202124" stopOpacity="0" />
          </linearGradient>
          <linearGradient id="bronzeChevronGrad" x1="1" y1="0" x2="0" y2="1">
            <stop offset="0%" stopColor="#C57950" stopOpacity="0.28" />
            <stop offset="60%" stopColor="#E69D73" stopOpacity="0.12" />
            <stop offset="100%" stopColor="#202124" stopOpacity="0" />
          </linearGradient>
        </defs>
        
        {/* Left Chevron pointing right (Silver) */}
        <path d="M-60 30 L200 250 L-60 470" stroke="url(#silverChevronGrad)" strokeWidth="76" strokeLinecap="square" />
        <path d="M-110 30 L150 250 L-110 470" stroke="url(#silverChevronGrad)" strokeWidth="38" opacity="0.6" />
        
        {/* Right Chevron pointing left (Bronze) */}
        <path d="M560 30 L300 250 L560 470" stroke="url(#bronzeChevronGrad)" strokeWidth="76" strokeLinecap="square" />
        <path d="M610 30 L350 250 L610 470" stroke="url(#bronzeChevronGrad)" strokeWidth="38" opacity="0.6" />
      </svg>

      {/* Silver plinth highlights behind the subject */}
      <div class="absolute inset-x-[15%] bottom-0 top-[10%] rounded-t-full border border-white/5 bg-gradient-to-b from-white/[0.04] via-white/[0.01] to-transparent z-0"></div>

      {hasPortrait ? (
        <img
          src={`/${PORTRAIT}`}
          alt="An iSmart merchant accepting a digital payment securely"
          class="relative z-10 mx-auto h-[480px] md:h-[580px] w-auto max-w-[95%] object-contain object-bottom select-none drop-shadow-[0_25px_50px_rgba(0,0,0,0.65)] scale-[1.3] md:scale-[1.5] origin-bottom translate-y-[2%]"
          width="1200"
          height="1200"
          fetchpriority="high"
          decoding="async"
        />
      ) : (
        <div
          class="relative z-10 mx-auto flex h-[260px] w-[70%] items-end justify-center rounded-t-full border border-dashed border-white/15 pb-8 bg-graphite-light/20"
        >
          <p class="max-w-[24ch] font-mono text-[0.625rem] leading-relaxed tracking-wide text-silver-600">
            PORTRAIT SLOT — drop a cut-out PNG at
            <span class="text-bronze-500"> public/{PORTRAIT}</span>
          </p>
        </div>
      )}

      {/* Grounding shadow blending the portrait bottom into the dark ground */}
      <div class="pointer-events-none absolute inset-x-0 bottom-0 z-20 h-24 bg-gradient-to-t from-graphite-dark to-transparent"></div>
    </div>
  </div>
</section>

<style>
  /* Strips are masked out at the top so they never reach the headline, and
     faded at the bottom so they dissolve into the ground. */
  .strip-field {
    mask-image: linear-gradient(to bottom, transparent 0%, #000 26%, #000 74%, transparent 100%);
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, #000 26%, #000 74%, transparent 100%);
  }

  .strip {
    position: absolute;
    bottom: 0;
    display: block;
    border-radius: 999px;
    animation-name: strip-drift;
    animation-timing-function: cubic-bezier(0.45, 0, 0.55, 1);
    animation-iteration-count: infinite;
    animation-direction: alternate;
  }

  .strip-silver {
    background: linear-gradient(to top, transparent, rgba(201, 205, 211, 0.45) 45%, rgba(226, 229, 233, 0.8));
  }

  .strip-bronze {
    background: linear-gradient(to top, transparent, rgba(197, 121, 80, 0.55) 45%, rgba(229, 168, 127, 0.95));
    box-shadow: 0 0 22px rgba(197, 121, 80, 0.28);
  }

  /* Slow, small, alternating — reads as breathing, never as motion graphics. */
  @keyframes strip-drift {
    from { transform: translateY(5%)  scaleY(0.94); opacity: 0.5; }
    to   { transform: translateY(-4%) scaleY(1);    opacity: 0.95; }
  }

  @media (prefers-reduced-motion: reduce) {
    .strip { animation: none; opacity: 0.7; }
  }

  /* On narrow screens drop the outer strips so the field stays uncluttered. */
  @media (max-width: 767px) {
    .strip:nth-child(n + 5):nth-child(-n + 6),
    .strip:nth-child(n + 11) { display: none; }
  }
</style>
