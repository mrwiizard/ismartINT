---
import { ArrowRight } from 'lucide-react';

/**
 * SECTION 01 — HERO
 *
 * Composition: a single full-bleed image carries the whole frame, and the type
 * sits left over the dark side of it. The scrim is a left-to-right gradient
 * rather than a flat wash, so the bronze vortex stays legible on the right
 * while the text keeps a solid ground on the left.
 *
 * Nothing animates behind the type — no canvas, no JS on the critical path.
 */

// Strip field: silver by default, bronze used sparingly as the accent.
const strips = [
  { left: 4,  w: 2,  h: 62, tone: 'silver', delay: 0,    dur: 15 },
  { left: 11, w: 1,  h: 84, tone: 'silver', delay: -3,   dur: 19 },
  { left: 17, w: 3,  h: 46, tone: 'bronze', delay: -6,   dur: 17 },
  { left: 24, w: 1,  h: 72, tone: 'silver', delay: -1.5, dur: 21 },
  { left: 30, w: 2,  h: 92, tone: 'silver', delay: -8,   dur: 16 },
  { left: 36, w: 1,  h: 54, tone: 'silver', delay: -4,   dur: 23 },

  { left: 63, w: 1,  h: 58, tone: 'silver', delay: -2,   dur: 20 },
  { left: 69, w: 2,  h: 88, tone: 'silver', delay: -7,   dur: 17 },
  { left: 76, w: 1,  h: 68, tone: 'silver', delay: -5,   dur: 22 },
  { left: 82, w: 3,  h: 44, tone: 'bronze', delay: -9,   dur: 18 },
  { left: 89, w: 1,  h: 78, tone: 'silver', delay: -3.5, dur: 15 },
  { left: 95, w: 2,  h: 60, tone: 'silver', delay: -6.5, dur: 24 },
];
---

<section
  data-nav-theme="dark"
  class="hero bg-[#030304] relative isolate flex min-h-[100svh] flex-col justify-center overflow-hidden"
>
  {/* Ambient subtle glow behind right visual */}
  <div class="pointer-events-none absolute right-0 top-1/2 -translate-y-1/2 w-[700px] h-[700px] bg-[radial-gradient(circle,rgba(197,121,80,0.07)_0%,transparent_70%)] -z-10 blur-2xl"></div>

  {/* ================= CONTENT ================= */}
  <div class="relative z-10 mx-auto flex w-full max-w-7xl flex-col lg:flex-row items-center justify-between px-6 py-28 md:px-10 lg:px-12 gap-12 lg:gap-8">
    {/* Left Column: Text & CTA */}
    <div class="flex max-w-2xl flex-col items-start text-left z-10">
      {/* Eyebrow — one rule, on the side the type starts from */}
      <div data-reveal="fade" class="mb-7 flex items-center gap-3 text-silver-400">
        <span class="h-px w-8 bg-gradient-to-r from-transparent to-bronze-500"></span>
        <span class="eyebrow">Digital Financial Infrastructure</span>
      </div>

      <h1
        data-reveal
        style="--reveal-delay:80ms"
        class="max-w-[16ch] font-display text-[clamp(2.5rem,5.5vw,5.25rem)] font-extrabold leading-[0.98] tracking-[-0.035em]"
      >
        <span class="text-metal">Powering Africa's next generation of</span>
        <span class="text-metal"> digital payments.</span>
      </h1>

      <div data-reveal style="--reveal-delay:180ms" class="mt-8 flex flex-wrap items-center justify-start gap-4">
        <a href="#ecosystem" class="btn-metal">
          Explore our ecosystem
          <ArrowRight className="h-4 w-4 transition-transform duration-500 group-hover:translate-x-1" />
        </a>

        <a
          href="/contact/"
          class="inline-flex items-center rounded-full border border-white/15 bg-white/[0.03] px-8 py-4 font-display text-sm font-semibold text-silver-200 backdrop-blur-sm transition-all duration-500 hover:border-bronze-500/50 hover:bg-white/[0.06] hover:text-white"
        >
          Talk to iSmart
        </a>
      </div>
    </div>

    {/* Right Column: Cowries Stroke Visual */}
    <div class="w-full lg:w-auto flex-1 flex items-center justify-center lg:justify-end relative">
      <div class="cowrie-floating relative w-full max-w-[460px] sm:max-w-[560px] lg:max-w-[680px] xl:max-w-[780px] 2xl:max-w-[880px] flex items-center justify-center">
        <img
          src="/business-cards/cowries-stroke.jpg"
          alt="iSmart Bronze Cowrie"
          fetchpriority="high"
          loading="eager"
          decoding="async"
          class="w-full h-auto max-h-[92vh] object-contain select-none mix-blend-screen [mask-image:radial-gradient(ellipse_at_center,black_60%,transparent_92%)] [-webkit-mask-image:radial-gradient(ellipse_at_center,black_60%,transparent_92%)]"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .cowrie-floating {
    animation: cowrie-float 8s ease-in-out infinite alternate;
    will-change: transform;
    transform-origin: center center;
    transform: rotate(-40deg);
  }

  @keyframes cowrie-float {
    0% {
      transform: translateY(0px) rotate(-40deg) scale(1);
    }
    50% {
      transform: translateY(-22px) rotate(-37.5deg) scale(1.025);
    }
    100% {
      transform: translateY(-8px) rotate(-42deg) scale(1.01);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cowrie-floating {
      animation: none;
      transform: rotate(-40deg);
    }
  }
</style>
