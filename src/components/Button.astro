---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'emerald' | 'bronze' | 'white' | 'outline' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
  id?: string;
  [key: string]: any;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  class: className = '',
  id,
  ...rest
} = Astro.props;

// Component element type (a or button)
const Element = href ? 'a' : 'button';

// Styling classes
const baseClasses = 'inline-flex items-center justify-center font-display font-medium tracking-wide rounded-full transition-all duration-300 select-none cursor-pointer focus:outline-none focus:ring-1 focus:ring-brand-emerald';

const sizeClasses = {
  sm: 'px-5 py-2 text-xs',
  md: 'px-7 py-3 text-sm',
  lg: 'px-9 py-4 text-base',
}[size];

const variantClasses = {
  primary: 'bg-brand-emerald text-white hover:bg-brand-emerald-light hover:shadow-[0_0_20px_rgba(0,109,91,0.25)]',
  secondary: 'bg-graphite-dark text-white hover:bg-graphite-light hover:shadow-[0_0_15px_rgba(32,33,36,0.25)]',
  emerald: 'bg-brand-emerald text-white hover:bg-emerald-700 hover:shadow-[0_0_20px_rgba(0,109,91,0.3)]',
  bronze: 'bg-brand-bronze text-white hover:bg-amber-700 hover:shadow-[0_0_20px_rgba(197,121,80,0.3)]',
  white: 'bg-white text-graphite-dark hover:bg-off-white hover:shadow-[0_0_20px_rgba(255,255,255,0.45)]',
  outline: 'bg-transparent text-current border border-current hover:bg-current/5',
  ghost: 'bg-transparent text-current hover:bg-current/5',
}[variant];
---

<Element
  href={href}
  class={`${baseClasses} ${sizeClasses} ${variantClasses} ${className}`}
  id={id}
  {...rest}
>
  <slot />
</Element>
