---
import Logo from './Logo.astro';
import { ArrowUpRight } from 'lucide-react';
---

<footer class="bg-graphite-dark border-t border-graphite-border/40 pt-16 md:pt-24 pb-44 md:pb-60 relative overflow-hidden">
  {/* Subtle footer grid lines */}
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_bottom_center,rgba(0,109,91,0.03),transparent_70%)] pointer-events-none" />

  <div class="max-w-7xl mx-auto px-6 md:px-12 relative text-silver-bright">
    {/* Grid */}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-12 md:gap-8 pb-16 border-b border-graphite-border/30">
      {/* Column 1: Brand */}
      <div class="lg:col-span-2 flex flex-col gap-6">
       
        <p class="text-sm text-silver-muted max-w-sm leading-relaxed">
          iSmart International builds secure, borderless digital infrastructure to move money, connect devices, and power modern businesses across Africa and the globe.
        </p>
        <div class="flex gap-4 items-center">
          <a href="#" class="p-2 rounded-full border border-graphite-border hover:border-brand-emerald text-silver-muted hover:text-white transition-colors duration-300">
            <span class="sr-only">LinkedIn</span>
            <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
          </a>
          <a href="#" class="p-2 rounded-full border border-graphite-border hover:border-brand-bronze text-silver-muted hover:text-white transition-colors duration-300">
            <span class="sr-only">Twitter</span>
            <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24"><path d="M24 4.557c-.883.392-1.832.656-2.828.775 1.017-.609 1.798-1.574 2.165-2.724-.951.564-2.005.974-3.127 1.195-.897-.957-2.178-1.555-3.594-1.555-3.179 0-5.515 2.966-4.797 6.045-4.091-.205-7.719-2.165-10.148-5.144-1.29 2.213-.669 5.108 1.523 6.574-.806-.026-1.566-.247-2.229-.616-.054 2.281 1.581 4.415 3.949 4.89-.693.188-1.452.232-2.224.084.626 1.956 2.444 3.379 4.6 3.419-2.07 1.623-4.678 2.348-7.29 2.04 2.179 1.397 4.768 2.212 7.548 2.212 9.142 0 14.307-7.721 13.995-14.646.962-.695 1.797-1.562 2.457-2.549z"/></svg>
          </a>
        </div>
      </div>

      {/* Column 2: Solutions */}
      <div class="flex flex-col gap-4">
        <h4 class="text-xs font-semibold tracking-widest text-silver-muted uppercase">Solutions</h4>
        <ul class="flex flex-col gap-3">
          <li><a href="/solutions/ismartpay/" class="text-sm text-silver-muted hover:text-white transition-colors duration-300">iSmartPay</a></li>
          <li><a href="/solutions/merchant/" class="text-sm text-silver-muted hover:text-white transition-colors duration-300">Merchant Terminal</a></li>
          <li><a href="/solutions/connectivity/" class="text-sm text-silver-muted hover:text-white transition-colors duration-300">GlobTalk eSIM</a></li>
          <li><a href="/solutions/enterprise/" class="text-sm text-silver-muted hover:text-white transition-colors duration-300">Enterprise Solutions</a></li>
        </ul>
      </div>

      {/* Column 3: Company */}
      <div class="flex flex-col gap-4">
        <h4 class="text-xs font-semibold tracking-widest text-silver-muted uppercase">Company</h4>
        <ul class="flex flex-col gap-3">
          <li><a href="/company/about/" class="text-sm text-silver-muted hover:text-white transition-colors duration-300">About Us</a></li>
          <li><a href="/company/markets/" class="text-sm text-silver-muted hover:text-white transition-colors duration-300">Operational Markets</a></li>
          <li><a href="/company/leadership/" class="text-sm text-silver-muted hover:text-white transition-colors duration-300">Leadership</a></li>
          <li><a href="/insights/" class="text-sm text-silver-muted hover:text-white transition-colors duration-300 font-medium text-brand-bronze flex items-center gap-1 group">
            Insights 
            <ArrowUpRight class="h-3 w-3 opacity-60 group-hover:opacity-100 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all" />
          </a></li>
        </ul>
      </div>

      {/* Column 4: Developers & Legal */}
      <div class="flex flex-col gap-4">
        <h4 class="text-xs font-semibold tracking-widest text-silver-muted uppercase">Developers</h4>
        <ul class="flex flex-col gap-3">
          <li><a href="/developers/" class="text-sm text-silver-muted hover:text-white transition-colors duration-300">Developer Portal</a></li>
          <li><a href="/developers/#api" class="text-sm text-silver-muted hover:text-white transition-colors duration-300">API Documentation</a></li>
          <li><a href="/developers/#sandbox" class="text-sm text-silver-muted hover:text-white transition-colors duration-300">Sandbox Environment</a></li>
          <li><a href="/partners/" class="text-sm text-silver-muted hover:text-white transition-colors duration-300 flex items-center gap-1 group">
            Become a Partner
            <ArrowUpRight class="h-3 w-3 opacity-60 group-hover:opacity-100 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all" />
          </a></li>
        </ul>
      </div>
    </div>

    {/* ─── Accreditation ───
        Regulator and certification marks, on every page. The Bank of Ghana
        mark keeps its own light tile: a regulator's logo should be shown as
        issued, not recoloured or keyed out to suit a dark footer. */}
    <div class="accreditation">
      <span class="accreditation__label">Accreditation</span>

      <ul class="accreditation__list">
        <li class="accreditation__item">
          <span class="accreditation__tile">
            <img
              src="/accreditation/bank-of-ghana.webp"
              alt="Bank of Ghana"
              width="240"
              height="239"
              loading="lazy"
              decoding="async"
            />
          </span>
          <span class="accreditation__text">Licensed by the Bank of Ghana</span>
        </li>

        <li class="accreditation__item">
          <span class="accreditation__mark">ISO/IEC<br /><strong>27001</strong></span>
          <span class="accreditation__text">Information security management</span>
        </li>

        <li class="accreditation__item">
          <span class="accreditation__mark">PCI DSS<br /><strong>Level 1</strong></span>
          <span class="accreditation__text">Card data security</span>
        </li>
      </ul>
    </div>

    {/* Bottom row */}
    <div class="flex flex-col sm:flex-row justify-between items-center gap-6 pt-12 text-xs text-silver-muted/60 font-mono">
      <div>
        &copy; {new Date().getFullYear()} iSmart International. All rights reserved.
      </div>
      <div class="flex gap-6">
        <a href="/terms/" class="hover:text-white transition-colors duration-300">Terms of Infrastructure</a>
        <a href="/privacy/" class="hover:text-white transition-colors duration-300">Privacy Policy</a>
        <a href="/security/" class="hover:text-white transition-colors duration-300">Security & Compliance</a>
      </div>
    </div>
  </div>
  {/* ─── Oversized wordmark watermark ───
      The supplied logo artwork at full bleed, cropped by the footer's own edge
      and held at a whisper of opacity so it reads as an emboss in the surface
      rather than a second logo competing with the one above. */}
  <div class="footer-watermark pointer-events-none absolute inset-x-0 bottom-0 select-none" aria-hidden="true">
    <img
      src="/new ismart logo.png"
      alt=""
      width="2349"
      height="626"
      loading="lazy"
      decoding="async"
      class="w-full min-w-[720px] translate-y-[22%] object-contain"
    />
  </div>
</footer>


<style>
  /* Two things keep this classy rather than loud:
     the opacity floor, and a mask that dissolves the letterforms downward so
     they sink into the page edge instead of being bluntly cut off. */
  .footer-watermark {
    opacity: 0.05;
    mask-image: linear-gradient(to bottom, #000 0%, #000 42%, rgba(0, 0, 0, 0.35) 78%, transparent 100%);
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 42%, rgba(0, 0, 0, 0.35) 78%, transparent 100%);
  }

  /* A touch more presence on wide screens, where it has room to breathe. */
  @media (min-width: 1024px) {
    .footer-watermark { opacity: 0.06; }
  }
</style>

<style>
  .accreditation {
    margin-top: 3rem;
    padding-top: 2.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .accreditation__label {
    display: block;
    margin-bottom: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--color-silver-600);
  }

  .accreditation__list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 1.75rem;
  }

  .accreditation__item {
    display: flex;
    align-items: center;
    gap: 0.875rem;
  }

  /* The regulator mark, unaltered, on the white it was issued on. */
  .accreditation__tile {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 0.625rem;
    background: #fff;
    padding: 0.375rem;
  }

  .accreditation__tile img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* Certifications have no supplied artwork, so they are set as type. */
  .accreditation__mark {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 0.625rem;
    border: 1px solid rgba(255, 255, 255, 0.16);
    font-family: var(--font-mono);
    font-size: 0.5rem;
    line-height: 1.35;
    letter-spacing: 0.08em;
    text-align: center;
    color: var(--color-silver-500);
  }

  .accreditation__mark strong {
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--color-silver-200);
  }

  .accreditation__text {
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--color-silver-400);
  }

  @media (min-width: 700px) {
    .accreditation__list { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2rem; }
  }
</style>
