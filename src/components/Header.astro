---
import Logo from './Logo.astro';
import NavigationOverlay from '../islands/NavigationOverlay';

// The nav is deliberately down to three things: who you are, who we are, and
// the product. Everything else lives in the overlay menu and the footer.
const audiences = [
  { label: 'Personal', href: '/personal' },
  { label: 'Business',  href: '/business'  },
];

const path = Astro.url.pathname;
// Businesses carries the default weight — it is the primary audience for an
// infrastructure company, and a two-state switch reads as broken with neither
// side lit.
const activeAudience =
  audiences.find((a) => path.startsWith(a.href))?.href ?? '/businesses';
---

<header id="site-header" data-theme="dark" data-scrolled="false" class="fixed inset-x-0 top-0 z-50">
  <div class="header-inner mx-auto flex items-center justify-between">
    <a
      href="/"
      aria-label="iSmart International — home"
      class="logo-swap relative block shrink-0 transition-opacity duration-300 hover:opacity-80"
    >
      {/* Full lockup — shown at rest. */}
      <span class="logo-mark logo-mark--word">
        <Logo mark="wordmark" height={38} />
      </span>

      {/* Metallic circuit mark — takes over once the bar collapses to a pill. */}
      <span class="logo-mark logo-mark--icon" aria-hidden="true">
        <Logo mark="circuit" height={46} alt="" />
      </span>
    </a>

    <nav class="hidden items-center gap-7 lg:flex" aria-label="Primary">
      {/* Audience switch. Two real links styled as a segmented control, so it
          works without JavaScript and the active side is resolved per page. */}
      <div class="audience-switch" role="group" aria-label="Choose your audience">
        {audiences.map((a) => (
          <a
            href={a.href}
            class="audience-option"
            data-active={a.href === activeAudience ? 'true' : 'false'}
            aria-current={a.href === activeAudience ? 'page' : undefined}
          >
            {a.label}
          </a>
        ))}
      </div>

      <a
        href="/company/about"
        class="nav-link group relative font-sans text-[0.8125rem] font-medium tracking-tight transition-colors duration-300"
      >
        About us
        <span
          class="absolute -bottom-1.5 left-0 h-px w-0 bg-bronze-500 transition-all duration-500 group-hover:w-full"
        ></span>
      </a>
    </nav>

    <div class="flex items-center gap-3">
      <a
        href="https://www.pay.ismartghana.com"
        class="nav-cta hidden rounded-full border px-6 py-2.5 font-display text-[0.8125rem] font-semibold transition-all duration-400 sm:inline-flex"
      >
        iSmartPay
      </a>

      <button
        id="menu-trigger"
        class="nav-link flex h-10 w-10 items-center justify-center lg:hidden"
        aria-label="Open navigation"
        aria-expanded="false"
      >
        <span class="flex flex-col gap-[5px]">
          <span class="block h-px w-6 bg-current transition-transform duration-300"></span>
          <span class="block h-px w-6 bg-current transition-transform duration-300"></span>
        </span>
      </button>
    </div>
  </div>

  <NavigationOverlay client:idle />
</header>

<style>
  /* ─── Base State (top of page, full-width) ─── */
  .header-inner {
    max-width: 80rem;
    height: 5.75rem;
    padding: 0 1.5rem;
    gap: 2rem;
    position: relative;
    z-index: 1;
    transition:
      max-width 0.5s cubic-bezier(0.22, 1, 0.36, 1),
      height 0.5s cubic-bezier(0.22, 1, 0.36, 1),
      padding 0.5s cubic-bezier(0.22, 1, 0.36, 1),
      margin 0.5s cubic-bezier(0.22, 1, 0.36, 1),
      background 0.5s cubic-bezier(0.22, 1, 0.36, 1),
      border-radius 0.5s cubic-bezier(0.22, 1, 0.36, 1),
      border-color 0.5s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.5s cubic-bezier(0.22, 1, 0.36, 1);
    background: transparent;
    border: 1px solid transparent;
    border-radius: 0;
  }

  @media (min-width: 768px) {
    .header-inner { padding: 0 2.5rem; }
  }
  @media (min-width: 1024px) {
    .header-inner { padding: 0 3rem; }
  }

  /* ─── Scrolled State: Floating Pill ─── */
  #site-header[data-scrolled='true'] .header-inner {
    max-width: 56rem;
    height: 4.75rem;
    padding: 0 1.25rem;
    margin-top: 0.75rem;
    background: rgba(18, 19, 22, 0.88);
    backdrop-filter: blur(24px) saturate(180%);
    -webkit-backdrop-filter: blur(24px) saturate(180%);
    border-radius: 9999px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow:
      0 4px 24px rgba(0, 0, 0, 0.35),
      0 0 0 1px rgba(255, 255, 255, 0.04),
      inset 0 1px 0 rgba(255, 255, 255, 0.05);
  }

  @media (min-width: 768px) {
    #site-header[data-scrolled='true'] .header-inner { padding: 0 1.5rem; }
  }
  @media (min-width: 1024px) {
    #site-header[data-scrolled='true'] .header-inner { padding: 0 1.75rem; }
  }

  /* Tighten nav gaps in scrolled pill */
  #site-header[data-scrolled='true'] nav { gap: 1.5rem; }

  /* Shrink the CTA button in scrolled state */
  #site-header[data-scrolled='true'] .nav-cta {
    padding: 0.375rem 1rem;
    font-size: 0.75rem;
  }

  /* ─── NO pseudo-element backdrop for scrolled ─── */
  #site-header::before {
    content: '';
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }


  /* ─── Logo swap: wordmark ⇄ icon ───
     Both marks are rendered and stacked in the same slot, so the exchange is a
     cross-fade with no reflow, no layout shift and no late-loading flash. The
     slot's own width animates between the two intrinsic widths, letting the
     nav close up smoothly as the bar collapses. */
  .logo-swap {
    /* wordmark: 38px tall x 2349/626 aspect */
    width: 143px;
    height: 38px;
    transition: width 0.5s cubic-bezier(0.22, 1, 0.36, 1),
                height 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .logo-mark {
    position: absolute;
    top: 50%;
    left: 0;
    display: block;
    transform-origin: left center;
    transition: opacity 0.35s ease, transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .logo-mark--word {
    opacity: 1;
    transform: translateY(-50%) scale(1);
  }

  .logo-mark--icon {
    opacity: 0;
    transform: translateY(-50%) scale(0.8);
    pointer-events: none;
  }

  /* Collapsed pill: slot narrows to the square icon and the marks trade places. */
  /* circuit mark: 46px tall x 401/300 aspect */
  #site-header[data-scrolled='true'] .logo-swap {
    width: 61px;
    height: 46px;
  }

  #site-header[data-scrolled='true'] .logo-mark--word {
    opacity: 0;
    transform: translateY(-50%) scale(0.82);
    pointer-events: none;
  }

  #site-header[data-scrolled='true'] .logo-mark--icon {
    opacity: 1;
    transform: translateY(-50%) scale(1);
    pointer-events: auto;
  }

  /* The exchange is decorative; honour a reduced-motion preference by cutting
     straight to the end state rather than sliding through it. */
  @media (prefers-reduced-motion: reduce) {
    .logo-swap,
    .logo-mark { transition: none; }
  }

  /* ─── Audience switch ───
     A track with a filled segment, not two buttons in a box. The fill is what
     makes it read as a switch rather than a pair of tabs. */
  .audience-switch {
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 3px;
    border-radius: 9999px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.04);
    transition: border-color 0.4s ease, background 0.4s ease;
  }

  .audience-option {
    border-radius: 9999px;
    padding: 0.4375rem 0.9375rem;
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    white-space: nowrap;
    color: var(--color-silver-400);
    transition: background 0.45s cubic-bezier(0.22, 1, 0.36, 1),
                color 0.45s ease,
                box-shadow 0.45s ease;
  }

  .audience-option:hover { color: #fff; }

  .audience-option[data-active='true'] {
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.14),
      0 1px 3px rgba(0, 0, 0, 0.25);
  }

  /* Light sections: the track inverts along with the rest of the bar. */
  #site-header[data-theme='light'] .audience-switch {
    border-color: rgba(22, 23, 26, 0.14);
    background: rgba(22, 23, 26, 0.04);
  }
  #site-header[data-theme='light'] .audience-option { color: var(--color-ink-muted); }
  #site-header[data-theme='light'] .audience-option:hover { color: var(--color-ink); }
  #site-header[data-theme='light'] .audience-option[data-active='true'] {
    background: #fff;
    color: var(--color-ink);
    box-shadow: 0 1px 3px rgba(22, 23, 26, 0.14);
  }

  /* Once collapsed the pill is always dark, so the dark treatment wins back. */
  #site-header[data-scrolled='true'][data-theme='light'] .audience-switch {
    border-color: rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.04);
  }
  #site-header[data-scrolled='true'][data-theme='light'] .audience-option {
    color: var(--color-silver-400);
  }
  #site-header[data-scrolled='true'][data-theme='light'] .audience-option[data-active='true'] {
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.14);
  }

  @media (prefers-reduced-motion: reduce) {
    .audience-option { transition: none; }
  }

  /* ─── Adaptive nav colours ─── */
  #site-header[data-theme='dark'] .nav-link { color: var(--color-silver-400); }
  #site-header[data-theme='dark'] .nav-link:hover { color: #fff; }
  #site-header[data-theme='dark'] .nav-cta {
    color: var(--color-silver-100);
    border-color: rgba(255, 255, 255, 0.18);
  }
  #site-header[data-theme='dark'] .nav-cta:hover {
    border-color: var(--color-bronze-500);
    background: rgba(255, 255, 255, 0.06);
    color: #fff;
  }

  #site-header[data-theme='light'] .nav-link { color: var(--color-ink-muted); }
  #site-header[data-theme='light'] .nav-link:hover { color: var(--color-ink); }
  #site-header[data-theme='light'] .nav-cta {
    color: var(--color-ink);
    border-color: rgba(22, 23, 26, 0.18);
  }
  #site-header[data-theme='light'] .nav-cta:hover {
    border-color: var(--color-emerald-700);
    background: var(--color-emerald-50);
    color: var(--color-emerald-800);
  }

  /* Invert logo on light backgrounds */
  #site-header[data-theme='light'] :global(.logo-mark--word .logo-img) {
    filter: brightness(0) opacity(0.92);
  }

  /* When scrolled over light sections, force dark pill bg and white text */
  #site-header[data-scrolled='true'][data-theme='light'] .nav-link {
    color: var(--color-silver-400);
  }
  #site-header[data-scrolled='true'][data-theme='light'] .nav-link:hover {
    color: #fff;
  }
  #site-header[data-scrolled='true'][data-theme='light'] .nav-cta {
    color: var(--color-silver-100);
    border-color: rgba(255, 255, 255, 0.18);
  }
  #site-header[data-scrolled='true'][data-theme='light'] .nav-cta:hover {
    border-color: var(--color-bronze-500);
    background: rgba(255, 255, 255, 0.06);
    color: #fff;
  }
  #site-header[data-scrolled='true'][data-theme='light'] :global(.logo-img) {
    filter: none;
  }
</style>

<script>
  const initHeader = () => {
    const header = document.getElementById('site-header');
    if (!header) return;

    const sections = Array.from(
      document.querySelectorAll<HTMLElement>('[data-nav-theme]')
    );

    let ticking = false;

    const update = () => {
      ticking = false;

      header.dataset.scrolled = window.scrollY > 24 ? 'true' : 'false';

      // Whichever themed section sits under the middle of the header wins.
      const probe = header.offsetHeight / 2;
      let theme = 'dark';
      for (const section of sections) {
        const rect = section.getBoundingClientRect();
        if (probe >= rect.top && probe <= rect.bottom) {
          theme = section.dataset.navTheme || 'dark';
        }
      }
      header.dataset.theme = theme;
    };

    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    update();

    document.getElementById('menu-trigger')?.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('toggle-solutions-menu'));
    });
  };

  initHeader();
  document.addEventListener('astro:after-swap', initHeader);
</script>
