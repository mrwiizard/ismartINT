---
import { ISMARTPAY_URL } from '../../config/site';
import MainLayout from '../../layouts/MainLayout.astro';
import WaveDivider from '../../components/WaveDivider.astro';
import Logo from '../../components/Logo.astro';
import { ArrowRight } from 'lucide-react';

/**
 * ABOUT iSMART INTERNATIONAL — HERO
 *
 * A light hero, deliberately. The supplied photograph is bright and airy
 * (measured median luminance 152), so a graphite or black ground would leave it
 * sitting on the page like a lightbox rather than belonging to it. Warm white
 * also gives the site the light/dark rhythm the brand system asks for: graphite
 * home, black business, paper here.
 *
 * Type holds the left. The photograph runs full height on the right and bleeds
 * off the edge, so it reads as a window into a working day rather than a framed
 * picture placed on a page.
 *
 * Layout lives in plain CSS, not arbitrary utilities — the two-column geometry
 * is load-bearing, and it should not depend on a class being scanned.
 */
---

<MainLayout
  title="About iSmart International | Digital financial infrastructure for Africa"
  description="iSmart International engineers the payment, connectivity and technology infrastructure behind businesses across Africa — from a single market stall to a national retailer."
>
  <section data-nav-theme="dark" class="about-hero">
    {/* ================= FULL-BLEED PHOTOGRAPH ================= */}
    <img
      src="/about-hero-1600.webp"
      srcset="/about-hero-900.webp 900w, /about-hero-1600.webp 1600w"
      sizes="100vw"
      alt="A business owner working at her laptop in her studio"
      width="1600"
      height="1066"
      fetchpriority="high"
      decoding="async"
      class="about-photo"
    />

    {/* Scrims. Measured, not guessed: the copy zone of this photograph runs to
        255 luminance in places, so white type over it unscrimmed sits at
        2.9:1. These hold it at 7.2:1 while leaving the subject untouched. */}
    <div class="about-scrim" aria-hidden="true"></div>
    <div class="about-scrim-top" aria-hidden="true"></div>

    {/* ================= COPY ================= */}
    <div class="about-copy">
      <span data-reveal="fade" class="about-eyebrow">About us</span>

      <h1 data-reveal style="--reveal-delay:80ms" class="about-title font-display">
        We build what African commerce runs on.
      </h1>

      <p data-reveal style="--reveal-delay:170ms" class="about-lede">
        iSmart International engineers the payment and technology infrastructure
        behind businesses across the continent.
      </p>

      <div data-reveal style="--reveal-delay:250ms" class="about-actions">
        <a href="/business/" class="about-cta">What we build</a>
        <a href={ISMARTPAY_URL} class="about-link">Go to iSmartPay</a>
      </div>
    </div>
  </section>

  <WaveDivider to="var(--color-paper-warm)" accent="bronze" />

  {/* ══════════════ 2 · HOW iSMART IS BUILT ══════════════
      The collage is not decoration: business, the infrastructure beneath, and
      personal — the three things the copy names, in that order. */}
  <section data-nav-theme="light" class="ab-two">
    <div class="ab-two__inner">
      <div data-reveal="fade" class="ab-collage">
        {/* back — business */}
        <figure class="ab-panel ab-panel--business">
          <img
            src="/businesses/smiling-african-entrepreneur-cafe-counter-using-digital-tabl.webp"
            alt="A cafe owner working at her counter"
            width="900" height="600" loading="lazy" decoding="async"
          />
        </figure>

        {/* front — the infrastructure both sides run on */}
        <figure class="ab-panel ab-panel--core" aria-hidden="true">
          <span class="ab-panel__label">iSmart International</span>
          <img
            src="/mark-titanium-plate.webp"
            alt=""
            width="700" height="449"
            loading="lazy" decoding="async"
            class="ab-panel__plate"
          />
          <span class="ab-panel__rule"></span>
          <span class="ab-panel__sub">Infrastructure layer</span>
        </figure>

        {/* top — personal */}
        <figure class="ab-panel ab-panel--personal">
          <img
            src="/businesses/young-attractive-woman-jacket-holding-lot-shopping-packages-.webp"
            alt="A shopper carrying her purchases"
            width="600" height="900" loading="lazy" decoding="async"
          />
        </figure>
      </div>

      <div class="ab-two__copy">
        <span data-reveal="fade" class="eyebrow ab-two__eyebrow">How iSmart is built</span>

        <h2 data-reveal style="--reveal-delay:80ms" class="ab-two__title font-display">
          One company. Two ways in.
        </h2>

        <p data-reveal style="--reveal-delay:160ms" class="ab-two__body">
          iSmart International builds the financial infrastructure. <strong>iSmartPay</strong>,
          our payment service provider, is how that infrastructure reaches people —
          as everyday payments for individuals, and as <strong>iSmart Classic</strong>
          for business.
        </p>

        <div data-reveal style="--reveal-delay:230ms" class="ab-two__routes">
          <a href="/personal/" class="ab-route">
            <span class="ab-route__label">Personal</span>
            <span class="ab-route__desc">Send, pay and manage everyday money.</span>
          </a>
          <a href="/business/" class="ab-route">
            <span class="ab-route__label">iSmart Classic</span>
            <span class="ab-route__desc">Accept payments and settle across markets.</span>
          </a>
        </div>

        <div data-reveal style="--reveal-delay:300ms" class="ab-two__actions">
          <a href={ISMARTPAY_URL} class="btn-metal btn-metal--bronze">Explore iSmartPay</a>
        </div>
      </div>
    </div>
  </section>

  {/* ══════════════ 3 · TRUST ══════════════
      The reference centres a shield. iSmart's mark is a wave, so the ripples
      radiate from it instead — the same "reach" the shield conveys, drawn in
      the brand's own language rather than a borrowed one. */}
  <section data-nav-theme="dark" class="ab-trust">
    <div class="ab-trust__inner">
      <div data-reveal="fade" class="ab-ripple">
        <img
          src="/trust-cards-1100.webp"
          srcset="/trust-cards-700.webp 700w, /trust-cards-1100.webp 1100w"
          sizes="(min-width: 900px) 42vw, 86vw"
          alt=""
          aria-hidden="true"
          width="1056"
          height="1100"
          loading="lazy"
          decoding="async"
        />
      </div>

      <div class="ab-trust__copy">
       

        <h2 data-reveal style="--reveal-delay:80ms" class="ab-trust__title font-display">
          Your money deserves confidence.
        </h2>

        <p data-reveal style="--reveal-delay:160ms" class="ab-trust__body">
          Moving value asks more of a company than good engineering. iSmart holds
          <strong>PCI DSS Level 1</strong> certification the card industry's most
          rigorous tier of validation and treats the protection of transaction
          data as part of the infrastructure rather than a feature added on top.
        </p>

        <div data-reveal style="--reveal-delay:240ms" class="ab-trust__actions">
          <a href="/business/#how" class="ab-trust__link">
            See how payments are handled
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</MainLayout>

<style>
  .about-hero {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    min-height: 100svh;
    overflow: hidden;
    background-color: #0B0D0F;
    color: #fff;
  }

  .about-photo {
    position: absolute;
    inset: 0;
    z-index: -2;
    height: 100%;
    width: 100%;
    object-fit: cover;
    /* Holds the subject in frame as the crop tightens on tall viewports,
       and keeps the calmer left side under the copy. */
    object-position: 62% center;
  }

  /* Left-weighted, so the copy has a ground while the subject stays clear. */
  .about-scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      to right,
      rgba(8, 10, 12, 0.8) 0%,
      rgba(8, 10, 12, 0.62) 52%,
      rgba(8, 10, 12, 0) 82%
    );
  }

  /* The header sits over a band of this photograph that runs to 245 luminance,
     so the nav gets its own falloff rather than relying on the one above. */
  .about-scrim-top {
    position: absolute;
    inset: 0 0 auto 0;
    z-index: -1;
    height: 26%;
    background: linear-gradient(to bottom, rgba(8, 10, 12, 0.55), transparent);
  }

  /* ─── Copy ─── */
  .about-copy {
    position: relative;
    width: 100%;
    max-width: 78rem;
    margin: 0 auto;
    padding: 8rem 1.5rem 5rem;
  }

  @media (min-width: 768px) {
    .about-copy { padding: 8rem 2.5rem 5rem; }
  }

  @media (min-width: 1280px) {
    .about-copy { padding-left: 4rem; }
  }

  .about-eyebrow {
    display: block;
    font-size: 1rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.82);
  }

  .about-title {
    margin-top: 1.25rem;
    max-width: 18ch;
    /* Smaller than a landing headline: on a photograph the type is a caption
       to the image, not a billboard competing with it. */
    font-size: clamp(2.25rem, 3.9vw, 3.5rem);
    font-weight: 800;
    line-height: 1.04;
    letter-spacing: -0.032em;
    color: #fff;
    text-wrap: balance;
  }

  .about-lede {
    margin-top: 1.5rem;
    max-width: 46ch;
    font-size: clamp(1rem, 1.05vw, 1.125rem);
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.85);
  }

  .about-actions {
    margin-top: 2.25rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
  }

  .about-cta {
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    background: #fff;
    padding: 0.9375rem 2rem;
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-ink);
    transition: background 0.4s var(--ease-brand), transform 0.4s var(--ease-brand);
  }

  .about-cta:hover { background: rgba(255, 255, 255, 0.88); }

  .about-link {
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.9);
    border-bottom: 1px solid rgba(255, 255, 255, 0.35);
    padding-bottom: 2px;
    transition: color 0.35s ease, border-color 0.35s ease;
  }

  .about-link:hover { color: #fff; border-color: #fff; }

  /* Phones: the crop gets tight, so the scrim wraps the whole frame instead of
     leaning left, and the copy sits lower in it. */
  @media (max-width: 767px) {
    .about-scrim {
      background: linear-gradient(
        to bottom,
        rgba(8, 10, 12, 0.55) 0%,
        rgba(8, 10, 12, 0.35) 35%,
        rgba(8, 10, 12, 0.82) 100%
      );
    }
    .about-photo { object-position: 68% center; }
  }

  /* ══════════════ 2 · how iSmart is built ══════════════
     Warm white with the faintest emerald and bronze weather, so the surface
     has depth without reading as a colour. */
  .ab-two {
    background-color: var(--color-paper-warm);
    background-image:
      radial-gradient(58% 46% at 16% 22%, rgba(0, 109, 91, 0.05), transparent 70%),
      radial-gradient(50% 40% at 88% 84%, rgba(197, 121, 80, 0.05), transparent 72%);
    padding: 5rem 1.5rem 6rem;
  }

  .ab-two__inner {
    width: 100%;
    max-width: 74rem;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 3.5rem;
    align-items: center;
  }

  /* ─ collage ─ */
  .ab-collage {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 0.86;
    max-width: 34rem;
    justify-self: center;
  }

  .ab-panel {
    position: absolute;
    margin: 0;
    overflow: hidden;
    border-radius: 1.25rem;
    background: var(--color-graphite-900);
    box-shadow: 0 24px 50px -20px rgba(22, 23, 26, 0.34);
  }

  .ab-panel img {
    display: block;
    height: 100%;
    width: 100%;
    object-fit: cover;
  }

  .ab-panel--business { left: 0;   top: 14%;  width: 52%; aspect-ratio: 3 / 2.4; }
  .ab-panel--personal { right: 0;  top: 0;    width: 44%; aspect-ratio: 3 / 3.2; }

  /* The core panel overlaps both, because it sits under both. */
  .ab-panel--core {
    left: 22%;
    bottom: 0;
    width: 58%;
    aspect-ratio: 3 / 2.1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.625rem;
    padding: 1.5rem;
    background:
      radial-gradient(80% 60% at 24% 20%, rgba(0, 109, 91, 0.34), transparent 68%),
      linear-gradient(158deg, #1A1C1F 0%, #0B0C0E 100%);
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 34px 64px -22px rgba(22, 23, 26, 0.52);
  }

  .ab-panel__label {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--color-bronze-500);
  }

  .ab-panel__plate {
    width: 62%;
    height: auto;
    border-radius: 0.5rem;
    box-shadow: 0 12px 24px -10px rgba(0, 0, 0, 0.6);
  }

  .ab-panel__rule {
    display: block;
    height: 1px;
    width: 2.5rem;
    background: linear-gradient(to right, var(--color-bronze-600), var(--color-emerald-600));
  }

  .ab-panel__sub {
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-silver-300);
  }

  /* ─ copy ─ */
  .ab-two__copy { width: 100%; max-width: 34rem; justify-self: center; }
  .ab-two__eyebrow { color: var(--color-bronze-900); }

  .ab-two__title {
    margin-top: 1.25rem;
    font-size: clamp(2rem, 4vw, 3.25rem);
    font-weight: 800;
    line-height: 1.04;
    letter-spacing: -0.035em;
    color: var(--color-ink);
    text-wrap: balance;
  }

  .ab-two__body {
    margin-top: 1.5rem;
    max-width: 46ch;
    font-size: clamp(1rem, 1.05vw, 1.125rem);
    line-height: 1.66;
    color: var(--color-ink-muted);
  }

  .ab-two__body strong { color: var(--color-ink); font-weight: 650; }

  /* Two routes, as rules rather than cards. */
  .ab-two__routes { margin-top: 2.25rem; display: grid; gap: 0; }

  .ab-route {
    display: grid;
    gap: 0.25rem;
    padding: 1.125rem 0;
    border-top: 1px solid rgba(22, 23, 26, 0.12);
    transition: border-color 0.4s ease;
  }

  .ab-route:last-child { border-bottom: 1px solid rgba(22, 23, 26, 0.12); }
  .ab-route:hover { border-color: var(--color-emerald-700); }

  .ab-route__label {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    color: var(--color-ink);
  }

  .ab-route:hover .ab-route__label { color: var(--color-emerald-700); }

  .ab-route__desc { font-size: 0.875rem; color: var(--color-ink-muted); }

  .ab-two__actions { margin-top: 2rem; }

  @media (min-width: 900px) {
    .ab-two { padding: 7rem 2.5rem 8rem; }
    .ab-two__inner { grid-template-columns: 1fr 1fr; gap: 4.5rem; }
    .ab-collage { justify-self: start; max-width: none; }
    .ab-two__copy { justify-self: start; }
  }


  /* ══════════════ 3 · trust ══════════════
     Very dark graphite, emerald as the only light, bronze reduced to a single
     hairline. Calm — the brief asks this section to be the quietest on the
     page, not the loudest. */
  .ab-trust {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background-color: #000;
    padding: 6rem 1.5rem 7rem;
  }

  .ab-trust__inner {
    width: 100%;
    max-width: 74rem;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 3rem;
    align-items: center;
  }

  /* The supplied render carries this side on its own. Its edges measure 6/255,
     so it meets the black ground with no visible frame and needs no treatment. */
  .ab-ripple {
    position: relative;
    width: 100%;
    max-width: 30rem;
    justify-self: center;
  }

  .ab-ripple img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* ─ copy ─ */
  .ab-trust__copy { width: 100%; max-width: 34rem; justify-self: center; }
  .ab-trust__eyebrow { color: var(--color-bronze-500); }

  .ab-trust__title {
    margin-top: 1.25rem;
    font-size: clamp(2rem, 3.9vw, 3.125rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.034em;
    color: #fff;
    text-wrap: balance;
  }

  .ab-trust__body {
    margin-top: 1.5rem;
    max-width: 46ch;
    font-size: clamp(1rem, 1.05vw, 1.125rem);
    line-height: 1.68;
    color: var(--color-silver-400);
  }

  .ab-trust__body strong { color: #fff; font-weight: 650; }

  .ab-trust__actions { margin-top: 2.25rem; }

  .ab-trust__link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 600;
    color: #fff;
    border-bottom: 1px solid rgba(255, 255, 255, 0.28);
    padding-bottom: 3px;
    transition: color 0.4s ease, border-color 0.4s ease, gap 0.4s ease;
  }

  .ab-trust__link:hover {
    color: var(--color-emerald-400);
    border-color: var(--color-emerald-400);
    gap: 0.75rem;
  }

  @media (min-width: 900px) {
    .ab-trust { padding: 8rem 2.5rem 9rem; }
    .ab-trust__inner { grid-template-columns: 1fr 1fr; gap: 4.5rem; }
    .ab-ripple { justify-self: start; max-width: none; }
    .ab-trust__copy { justify-self: start; }
  }


</style>
