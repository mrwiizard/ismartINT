<script>
  // Autoplay is in the markup so the film is running before hydration, but a
  // reduced-motion preference wins: freeze on the poster frame instead.
  const film = document.getElementById('business-film') as HTMLVideoElement | null;
  if (film && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    film.autoplay = false;
